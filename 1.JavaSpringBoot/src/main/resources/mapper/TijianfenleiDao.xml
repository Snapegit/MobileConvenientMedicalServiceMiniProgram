<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.TijianfenleiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.TijianfenleiEntity" id="tijianfenleiMap">
        <result property="tijianfenlei" column="tijianfenlei"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.TijianfenleiView" >

		SELECT  tijianfenlei.* FROM tijianfenlei  tijianfenlei 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.TijianfenleiView" >
		SELECT * FROM tijianfenlei  tijianfenlei <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
